---
import { asset } from '../lib/site'

const steps = [
  {
    n: '01',
    title: 'Connect Google, once',
    body: 'Sign in with the Google account you use for Colab. The token goes straight into your system keychain; there is no NZAP account and no server in between.',
    image: 'screens/dark-01-connect.webp',
  },
  {
    n: '02',
    title: 'Pick an app',
    body: 'Each app shows the GPU it needs and how long setup and every run will take. Fill in a real form: voices, sliders, file uploads.',
    image: 'screens/dark-03-app-form.webp',
  },
  {
    n: '03',
    title: 'Press one button',
    body: 'NZAP starts the right runtime, installs and loads the model on Colab, and plays the result. The model stays warm for the next run.',
    image: 'screens/dark-05-app-result.webp',
  },
]
---

<section id="how" class="relative scroll-mt-24 border-y border-white/5 bg-panel/40 py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="reveal max-w-3xl">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-graphite">How it works</p>
      <h2 class="chrome-text mt-4 text-4xl font-medium tracking-[-0.03em] md:text-6xl">
        Three steps. No terminal required.
      </h2>
    </div>
    <ol class="mt-16 space-y-20 md:space-y-28">
      {steps.map((step, index) => (
        <li
          class:list={[
            'reveal grid items-center gap-10 md:grid-cols-[0.8fr_1.2fr]',
            index % 2 === 1 && 'md:[&>div:first-child]:order-2',
          ]}
        >
          <div>
            <p class="font-mono text-sm text-graphite">{step.n}</p>
            <h3 class="mt-3 text-3xl font-medium tracking-tight">{step.title}</h3>
            <p class="mt-4 text-base leading-relaxed text-graphite">{step.body}</p>
          </div>
          <div class="hairline overflow-hidden rounded-[22px] bg-panel shadow-[0_30px_90px_-30px_rgba(0,0,0,0.9)]">
            <img
              src={asset(step.image)}
              alt={step.title}
              loading="lazy"
              width="1440"
              height="900"
              class="block w-full"
            />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
