---
import { asset } from '../lib/site'

const features = [
  {
    title: 'Every Colab runtime',
    body: 'CPU, T4, L4, G4, A100, H100 and TPU v5e / v6e, with High-RAM. Keep-alive, restart, interrupt, release, and import runtimes started elsewhere.',
  },
  {
    title: 'AI Agents over MCP',
    body: 'Run `nzap-engine mcp` to give Claude Code, Cursor, Windsurf, or Antigravity 12 tools to allocate GPUs, run jobs, transfer files, and call apps.',
  },
  {
    title: 'Console and a real terminal',
    body: 'Streaming cell output, input() prompts, Drive and Cloud consent that pauses and resumes the cell, and a full shell on the VM.',
  },
  {
    title: 'Files, both ways',
    body: 'Browse, edit, upload by drag and drop, download straight to disk, rename and delete, on the runtime’s own file system.',
  },
  {
    title: 'Notebooks & 1-click apps',
    body: 'A public collection on GitHub plus your own private notebooks: forms for strings, numbers, selects and switches, exported as one file.',
  },
  {
    title: 'Ephemeral jobs',
    body: 'Run a script on a fresh VM, collect its artifacts and release the VM, always. Or run a local .py / .ipynb and get the executed notebook back.',
  },
  {
    title: 'Compute units in sight',
    body: 'Burn rate, free time left and low-balance alerts, from the same numbers Colab’s own clients use.',
  },
  {
    title: 'Private & self-updating',
    body: 'OAuth with PKCE, refresh tokens in your OS keychain, zero telemetry, and signed auto-updates verified before they install.',
  },
]

const shots = [
  { src: 'screens/dark-10-terminal.webp', label: 'Interactive VM Terminal' },
  { src: 'screens/dark-11-files.webp', label: 'Two-way File Manager' },
  { src: 'screens/dark-07-runtimes.webp', label: 'GPU & TPU Runtime Manager' },
]
---

<section id="features" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-24 md:px-8 md:py-36">
  <div class="reveal max-w-3xl">
    <p class="text-xs font-medium uppercase tracking-[0.22em] text-graphite">Features</p>
    <h2 class="chrome-text mt-4 text-3xl font-medium tracking-[-0.03em] sm:text-5xl md:text-6xl">
      Everything Colab does, in a native window.
    </h2>
    <p class="mt-5 text-base leading-relaxed text-graphite md:text-lg">
      NZAP Engine speaks the same protocol as Google’s own Colab CLI and VS Code extension, from a
      fast Rust core on Windows, macOS, and Linux.
    </p>
  </div>

  <ul class="mt-12 grid gap-px overflow-hidden rounded-[28px] bg-line/70 ring-1 ring-line/70 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4">
    {features.map((feature) => (
      <li class="reveal bg-stage p-6 transition-colors hover:bg-panel/80 md:p-7">
        <h3 class="font-medium text-ink">{feature.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-graphite">{feature.body}</p>
      </li>
    ))}
  </ul>

  <div class="mt-10 grid gap-5 sm:mt-12 md:grid-cols-3">
    {shots.map((shot) => (
      <figure class="reveal group">
        <div class="hairline overflow-hidden rounded-[18px] bg-panel transition-transform duration-300 group-hover:-translate-y-0.5">
          <img
            src={asset(shot.src)}
            alt={shot.label}
            loading="lazy"
            width="1440"
            height="900"
            class="block w-full"
          />
        </div>
        <figcaption class="mt-3 text-sm font-medium text-graphite">{shot.label}</figcaption>
      </figure>
    ))}
  </div>
</section>
