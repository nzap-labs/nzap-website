---
import { asset } from '../lib/site'

interface Props {
  size?: 'sm' | 'lg'
}
const { size = 'sm' } = Astro.props
const word = asset('brand/nzap-word-mask.png')
const dim = size === 'lg' ? 64 : 36
---

<span class:list={['inline-flex items-center', size === 'lg' ? 'gap-4' : 'gap-2.5']}>
  <span class:list={['relative inline-block shrink-0', size === 'lg' ? 'size-16' : 'size-9']}>
    <img
      src={asset('brand/nzap-mark-light-160.png')}
      alt=""
      aria-hidden="true"
      draggable="false"
      width={dim}
      height={dim}
      class="size-full object-contain dark:hidden"
    />
    <img
      src={asset('brand/nzap-mark-dark-160.png')}
      alt=""
      aria-hidden="true"
      draggable="false"
      width={dim}
      height={dim}
      class="hidden size-full object-contain drop-shadow-[0_0_12px_rgba(255,255,255,0.22)] dark:block"
    />
  </span>
  <span class="flex flex-col gap-1.5">
    <span
      role="img"
      aria-label="NZAP"
      class:list={['block aspect-[627/87] bg-ink', size === 'lg' ? 'h-5' : 'h-3']}
      style={`mask:url(${word}) no-repeat center/contain;-webkit-mask:url(${word}) no-repeat center/contain`}
    ></span>
    <span
      class:list={[
        'font-medium uppercase leading-none tracking-[0.42em] text-graphite',
        size === 'lg' ? 'text-xs' : 'text-[9px]',
      ]}
    >
      Engine
    </span>
  </span>
</span>
