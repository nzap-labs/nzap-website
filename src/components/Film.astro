---
import { asset } from '../lib/site'

const chapters = [
  { label: '0:00 · The Problem', time: 0 },
  { label: '0:06 · Meet NZAP Engine', time: 6.2 },
  { label: '0:12 · Connect Google', time: 12.1 },
  { label: '0:19 · Pick an App', time: 19.0 },
  { label: '0:28 · 1-Click T4', time: 28.0 },
  { label: '0:38 · Instant Warm Runs', time: 38.2 },
  { label: '0:47 · Terminal & Jobs', time: 47.0 },
  { label: '0:56 · Build an App', time: 56.0 },
]
---

<section id="film" class="relative scroll-mt-24 overflow-hidden py-24 md:py-36">
  <div class="studio-light pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-graphite">The Launch Film</p>
      <h2 class="chrome-text mt-4 text-3xl font-medium tracking-[-0.03em] sm:text-5xl md:text-6xl">
        Seventy seconds, start to sound.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-graphite md:text-lg">
        See how NZAP Engine turns a Google Colab GPU into a native AI workstation—with studio
        narration and score powered by ElevenLabs.
      </p>
    </div>

    <div class="reveal hairline relative mt-10 overflow-hidden rounded-[20px] bg-panel shadow-[0_40px_120px_-30px_rgba(0,0,0,0.95)] sm:mt-14 sm:rounded-[26px]">
      <video
        id="intro-film-video"
        class="block aspect-video w-full"
        controls
        preload="metadata"
        playsinline
        poster={asset('media/intro-poster.jpg')}
        aria-label="NZAP Engine introduction film"
      >
        <source src={asset('media/intro.mp4')} type="video/mp4" />
        <track
          kind="captions"
          src={asset('media/intro.vtt')}
          srclang="en"
          label="English"
          default
        />
      </video>
    </div>

    <div class="reveal mt-5 flex flex-wrap items-center justify-center gap-2">
      {chapters.map((ch) => (
        <button
          type="button"
          data-film-seek={String(ch.time)}
          class="hairline cursor-pointer rounded-full bg-white/[0.025] px-3 py-1.5 font-mono text-xs text-graphite transition-colors hover:bg-white/[0.08] hover:text-ink"
        >
          {ch.label}
        </button>
      ))}
    </div>
  </div>
</section>
