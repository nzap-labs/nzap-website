---
import { asset } from '../lib/site'
---

<section id="film" class="relative scroll-mt-24 overflow-hidden py-28 md:py-36">
  <div class="studio-light pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-graphite">The film</p>
      <h2 class="chrome-text mt-4 text-4xl font-medium tracking-[-0.03em] md:text-6xl">
        Seventy seconds, start to sound.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-graphite">
        The narration was generated by an NZAP app, Breeze TTS 2, on a free Colab T4.
      </p>
    </div>
    <div class="reveal hairline relative mt-14 overflow-hidden rounded-[26px] bg-panel shadow-[0_40px_120px_-30px_rgba(0,0,0,0.95)]">
      <video
        class="block aspect-video w-full"
        controls
        preload="none"
        playsinline
        poster={asset('media/intro-poster.jpg')}
        aria-label="NZAP Engine introduction film"
      >
        <source src={asset('media/intro.mp4')} type="video/mp4" />
        <track
          kind="captions"
          src={asset('media/intro.vtt')}
          srclang="en"
          label="English"
          default
        />
      </video>
    </div>
  </div>
</section>
