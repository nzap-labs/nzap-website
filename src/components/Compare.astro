---
import { ENGINE_PUBLIC } from '../lib/site'

type Cell = 'yes' | 'no' | string

const columns = ['NZAP Engine', 'Colab in a browser', 'Colab CLI / VS Code', 'Local app launchers']
const rows: { label: string; cells: Cell[] }[] = [
  { label: 'Runs models on a free cloud GPU', cells: ['yes', 'yes', 'yes', 'no'] },
  { label: 'Works without a GPU on your computer', cells: ['yes', 'yes', 'yes', 'no'] },
  { label: 'One-click AI apps with a real interface', cells: ['yes', 'no', 'no', 'yes'] },
  { label: 'Built-in MCP server for AI coding agents', cells: ['yes', 'no', 'no', 'no'] },
  { label: 'Knows the GPU and time an app needs', cells: ['yes', 'no', 'no', 'no'] },
  { label: 'Native app on Windows, macOS & Linux', cells: ['yes', '—', 'VS Code only', 'yes'] },
  { label: 'Terminal, files and ephemeral jobs', cells: ['yes', 'no jobs', 'CLI only', 'no'] },
  { label: 'No account or server of its own', cells: ['yes', 'yes', 'yes', 'yes'] },
  { label: 'Open source (Apache-2.0)', cells: [ENGINE_PUBLIC ? 'yes' : 'soon', 'no', 'yes', 'varies'] },
]
---

<section class="mx-auto max-w-7xl px-5 pb-24 md:px-8 md:pb-36">
  <div class="reveal flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div class="max-w-3xl">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-graphite">Why NZAP Engine</p>
      <h2 class="chrome-text mt-4 text-3xl font-medium tracking-[-0.03em] sm:text-4xl md:text-5xl">
        The cloud GPU you already have, finally easy.
      </h2>
    </div>
    <p class="text-xs text-graphite md:hidden">Swipe table horizontally →</p>
  </div>
  <div class="reveal hairline mt-8 overflow-x-auto rounded-[24px] bg-panel sm:mt-12">
    <table class="w-full min-w-[680px] text-left text-sm">
      <thead>
        <tr class="border-b border-white/5">
          <th class="sticky left-0 z-10 bg-panel/95 p-4 font-medium text-graphite backdrop-blur-sm sm:p-5">
            Capability
          </th>
          {columns.map((column, index) => (
            <th
              class:list={[
                'p-4 font-medium sm:p-5',
                index === 0 ? 'bg-white/[0.03] text-ink' : 'text-graphite',
              ]}
            >
              {column}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-white/5 last:border-0">
            <td class="sticky left-0 z-10 bg-panel/95 p-4 text-ink/90 backdrop-blur-sm sm:p-5">
              {row.label}
            </td>
            {row.cells.map((cell, index) => (
              <td class:list={['p-4 sm:p-5', index === 0 && 'bg-white/[0.03]']}>
                {cell === 'yes' ? (
                  <svg
                    viewBox="0 0 16 16"
                    class="size-4 text-mint"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    aria-label="Yes"
                  >
                    <path d="m3 8.5 3 3 7-7" />
                  </svg>
                ) : cell === 'no' ? (
                  <span class="text-graphite/60" aria-label="No">
                    —
                  </span>
                ) : (
                  <span class="text-graphite">{cell}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-xs text-graphite/80">
    Local app launchers run models on your own hardware. NZAP Engine is not affiliated with Google;
    Colab is a trademark of Google LLC.
  </p>
</section>
