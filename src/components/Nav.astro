---
import Logo from './Logo.astro'
import { links, loadOrgStats, RELEASE_VERSION } from '../lib/site'

const stats = await loadOrgStats()

const items = [
  { href: '#apps', label: 'Apps' },
  { href: '#install', label: 'CLI & Agents' },
  { href: '#how', label: 'How it works' },
  { href: '#features', label: 'Features' },
  { href: '#film', label: 'Film' },
  { href: '#community', label: 'Community' },
]
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-stage/75 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 md:px-8">
    <div class="flex items-center gap-3">
      <a href="#top" aria-label="NZAP Engine home" class="shrink-0">
        <Logo />
      </a>
      <a
        href={links.releases}
        class="hidden rounded-full bg-white/[0.04] px-2.5 py-0.5 font-mono text-[11px] text-graphite ring-1 ring-white/10 transition-colors hover:text-ink sm:inline-flex"
      >
        {RELEASE_VERSION}
      </a>
    </div>

    <ul class="hidden items-center gap-7 text-sm text-graphite lg:flex">
      {items.map((item) => (
        <li>
          <a href={item.href} class="transition-colors hover:text-ink">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={links.engine}
        class="hairline hidden items-center gap-2 rounded-full px-3.5 py-2 text-sm text-graphite transition-colors hover:text-ink sm:inline-flex"
        aria-label="NZAP Engine on GitHub"
      >
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span>GitHub</span>
        <span
          data-stars-total
          data-nav-stars
          class="rounded-full bg-white/8 px-2 py-0.5 font-mono text-xs tabular-nums text-ink"
        >
          ★ {stats.totalStars}
        </span>
      </a>
      <a
        href="#download"
        data-download
        class="chrome-fill inline-flex h-10 items-center rounded-full px-4 text-sm font-medium sm:px-5"
      >
        Download
      </a>
      <button
        type="button"
        data-mobile-menu-btn
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="hairline inline-flex size-10 cursor-pointer items-center justify-center rounded-full text-ink transition-colors hover:bg-white/5 lg:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Navigation Drawer -->
  <div
    data-mobile-menu
    class="hidden border-t border-white/5 bg-stage/95 px-5 py-5 backdrop-blur-2xl lg:hidden"
  >
    <ul class="flex flex-col gap-1">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class="flex items-center justify-between rounded-xl px-3 py-2.5 text-base font-medium text-ink/90 transition-colors hover:bg-white/5 hover:text-white"
          >
            {item.label}
            <span class="text-xs text-graphite">→</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-white/5 pt-4">
      <a
        href={links.engine}
        class="hairline inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm text-ink"
      >
        GitHub Repository
        <span data-stars-total class="font-mono text-xs text-mint">★ {stats.totalStars}</span>
      </a>
      <a
        href="#install"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-mint"
      >
        Install via CLI / AI Agent →
      </a>
    </div>
  </div>
</header>
