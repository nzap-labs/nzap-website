---
import { links } from '../lib/site'

const appJson = `{
  "format": "nzap-app/1",
  "category": "audio",
  "runtime": { "accelerator": "T4" },
  "estimates": { "setup": 50, "run": 2 },
  "inputs": [
    { "param": "text",  "widget": "textarea" },
    { "param": "voice", "widget": "select" },
    { "param": "speed", "widget": "slider",
      "min": 0.5, "max": 2, "step": 0.05 }
  ],
  "outputs": [{ "id": "speech", "kind": "audio" }]
}`

const notebook = `# notebook.py — runs on the user's own runtime
state = globals().setdefault("_nzap_apps", {}).setdefault(APP, {})
if "model" not in state:            # first run: set up once
    nzap("stage", id="load", label="Loading Kokoro-82M")
    state["model"] = load_model()

audio = state["model"](params["text"], voice=params["voice"])
sf.write(path, audio, 24_000)
nzap("output", id="speech", kind="audio", path=path)`

const steps = [
  ['notebook.py', 'Plain Python that reads params and reports progress and results.'],
  ['notebook.json', 'Title, description and typed parameters.'],
  ['app.json', 'The interface: widgets, runtime, timings, outputs.'],
]
---

<section
  id="build"
  class="relative scroll-mt-24 border-y border-white/5 bg-panel/40 py-28 md:py-36"
>
  <div class="mx-auto grid max-w-7xl items-start gap-14 px-5 md:px-8 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="reveal lg:sticky lg:top-28">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-graphite">Build an app</p>
      <h2 class="chrome-text mt-4 text-4xl font-medium tracking-[-0.03em] md:text-5xl">
        A notebook and one small JSON file.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-graphite">
        NZAP turns any notebook into an app: the form, the runtime picker, the timing and the audio,
        image or table output all come from <code class="font-mono text-ink">app.json</code>. Open a
        pull request and your app ships to every copy of NZAP Engine.
      </p>
      <ol class="mt-8 space-y-3">
        {steps.map(([file, text]) => (
          <li class="flex gap-4 rounded-2xl bg-white/[0.03] p-4">
            <code class="shrink-0 font-mono text-sm text-ink">{file}</code>
            <span class="text-sm text-graphite">{text}</span>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={links.appsGuide}
          class="chrome-fill inline-flex h-11 items-center rounded-full px-5 text-sm font-medium"
        >
          Read the app format
        </a>
        <a
          href={links.contributing}
          class="hairline inline-flex h-11 items-center rounded-full px-5 text-sm font-medium hover:bg-white/5"
        >
          Contributing guide
        </a>
      </div>
    </div>
    <div class="reveal space-y-5">
      <figure class="hairline overflow-hidden rounded-[22px] bg-[#09090b]">
        <figcaption class="border-b border-white/5 px-5 py-3 font-mono text-xs text-graphite">
          notebooks/kokoro-tts/app.json
        </figcaption>
        <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed text-ink/90"><code>{appJson}</code></pre>
      </figure>
      <figure class="hairline overflow-hidden rounded-[22px] bg-[#09090b]">
        <figcaption class="border-b border-white/5 px-5 py-3 font-mono text-xs text-graphite">
          notebooks/kokoro-tts/notebook.py (abridged)
        </figcaption>
        <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed text-ink/90"><code>{notebook}</code></pre>
      </figure>
    </div>
  </div>
</section>
